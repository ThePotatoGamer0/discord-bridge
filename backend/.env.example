DISCORD_BOT_TOKEN=your_bot_token_here
# Required in production. Dev falls back to a default if unset.
SESSION_SECRET=your_session_secret_here

# CORS: comma-separated origins, or set FRONTEND_URL (used if CORS_ORIGINS unset)
# CORS_ORIGINS=https://discord.potatogamer.uk

# Optional: auto-assign a role when users verify their site account
# VERIFIED_GUILD_ID=your_guild_snowflake
# VERIFIED_ROLE_ID=your_role_snowflake

# Linked Roles (Linked Roles Verification URL in Developer Portal)
# Set in Developer Portal: General Information > Linked Roles Verification Url
# Production: https://discordbackend.potatogamer.uk/linked-role
# Add redirect in OAuth2 > General: https://discordbackend.potatogamer.uk/discord-oauth-callback
DISCORD_CLIENT_ID=your_oauth2_client_id
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
DISCORD_REDIRECT_URI=https://discordbackend.potatogamer.uk/discord-oauth-callback

PORT=3000

# Production (split-host):
# Frontend: https://discord.potatogamer.uk
# Backend:  https://discordbackend.potatogamer.uk
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://discord.potatogamer.uk